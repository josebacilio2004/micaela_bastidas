# ============================================================
# MERCADO DE ABASTOS MICAELA BASTIDAS - ENVIRONMENT VARIABLES
# ============================================================

# --- POSTGRESQL CONFIGURATION ---
POSTGRES_USER=micaela_admin
POSTGRES_PASSWORD=MicaelaSeguro2026!
POSTGRES_DB=micaela_bastidas
POSTGRES_PORT=5432

# --- BACKEND API CONFIGURATION ---
PORT=3000
NODE_ENV=development
# Inside docker network:
DATABASE_URL="postgresql://micaela_admin:MicaelaSeguro2026!@postgres:5432/micaela_bastidas?schema=public"
# For local host testing when exposed:
LOCAL_DATABASE_URL="postgresql://micaela_admin:MicaelaSeguro2026!@localhost:5432/micaela_bastidas?schema=public"

# --- JWT SECURITY ---
JWT_SECRET=jwt_super_secret_micaela_bastidas_production_key_2026_auth
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=jwt_refresh_super_secret_micaela_bastidas_key_2026_auth
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS & APP CONFIG ---
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001,*"

# --- WEB CLIENT (NEXT.JS) ---
NEXT_PUBLIC_API_URL=/api
WEB_PORT=3001

# --- NGINX PROXY ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
