datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  ADMINISTRADOR
  TESORERA
  SERVICIOS_HIGIENICOS
  CONSULTA
}

enum MerchantTypeEnum {
  SOCIO
  INQUILINO
  AMBULANTE_FIJO
  AMBULANTE_TEMPORAL
}

enum MemberCondition {
  SOCIO_REGULAR
  SOCIO_EN_PRUEBA
  NO_APLICA
}

enum MerchantStatus {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

enum StallStatus {
  LIBRE
  OCUPADO
  RESERVADO
  INACTIVO
}

enum Periodicity {
  DIARIO
  MENSUAL
  POR_USO
}

enum ObligationStatus {
  PENDIENTE
  PAGADO
  VENCIDO
  ANULADO
}

enum PaymentMethod {
  EFECTIVO
  YAPE
  PLIN
  TRANSFERENCIA
}

enum CashRegisterStatus {
  ABIERTO
  CERRADO
  REABIERTO
  ANULADO
}

enum CashMovementType {
  INGRESO
  EGRESO
}

enum SessionStatus {
  ABIERTO
  CERRADO
}

enum TicketStatus {
  EMITIDO
  VERIFICADO
  DISCREPANCIA
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PAYMENT
  CLOSE
  REOPEN
  EXPORT
  SYNC
  ATTENDANCE
}

enum MeetingStatus {
  PROGRAMADA
  EN_CURSO
  FINALIZADA
  CANCELADA
}

enum DeviceStatus {
  ACTIVO
  BLOQUEADO
}

model User {
  id               String      @id @default(uuid())
  username         String      @unique
  email            String?     @unique
  passwordHash     String
  fullName         String
  phone            String?
  isActive         Boolean     @default(true)
  refreshTokenHash String?
  roles            UserRole[]

  openedRegisters   CashRegister[]           @relation("OpenedByUser")
  closedRegisters   CashRegister[]           @relation("ClosedByUser")
  reopenedRegisters CashRegister[]           @relation("ReopenedByUser")
  cashMovements     CashMovement[]
  collectedPayments Payment[]                @relation("CollectedByUser")
  sanitarySessions  SanitaryServiceSession[]
  auditLogs         AuditLog[]
  devices           Device[]
  registeredAttendances AttendanceEvent[]
  createdMeetings   Meeting[]
  uploadedDocuments MarketDocument[]
  createdFaenas     Faena[]
  registeredFaenaAttendances FaenaAttendance[]
  createdExpenses   MarketExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        RoleType   @unique
  description String?
  users       UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model MerchantType {
  id          String           @id @default(uuid())
  code        MerchantTypeEnum @unique
  name        String
  description String?
  merchants   Merchant[]
  rates       Rate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("merchant_types")
}

model Sector {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  stalls      MarketStall[]
  merchants   Merchant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sectors")
}

model MarketStall {
  id                  String      @id @default(uuid())
  code                String      @unique
  sectorId            String
  sector              Sector      @relation(fields: [sectorId], references: [id])
  giro                String?     // Giro comercial (ej. Carnes y Pescados, Frutas y Verduras, Abarrotes, etc.)
  stallNumber         Int?        // Número correlativo dentro del giro (ej. 1, 2, 3...)
  locationDescription String?
  status              StallStatus @default(LIBRE)
  assignedMerchant    Merchant?   @relation("StallMerchant")
  assignedAt          DateTime?
  observations        String?
  rentals             StallRentalContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([giro])
  @@index([stallNumber])
  @@map("market_stalls")
}

model Merchant {
  id               String         @id @default(uuid())
  internalCode     String         @unique
  firstName        String
  lastName         String
  dni              String         @unique
  phone            String?
  address          String?
  merchantTypeId   String
  merchantType     MerchantType   @relation(fields: [merchantTypeId], references: [id])
  sectorId         String?
  sector           Sector?        @relation(fields: [sectorId], references: [id])
  stallId          String?        @unique
  stall            MarketStall?   @relation("StallMerchant", fields: [stallId], references: [id])
  businessCategory String?
  entryDate        DateTime       @default(now())
  status           MerchantStatus @default(ACTIVO)
  isDeleted        Boolean        @default(false)
  photoUrl         String?
  utilityBillPdfUrl String?
  utilityBillUploadedAt DateTime?
  dniDocumentUrl   String?
  memberCondition  MemberCondition @default(NO_APLICA)
  qrCode           String         @unique
  observations     String?

  createdById String?
  updatedById String?

  obligations      PaymentObligation[]
  payments         Payment[]
  attendances      AttendanceEvent[]
  documents        MarketDocument[]
  faenaAttendances FaenaAttendance[]
  loans            Loan[]
  rentals          StallRentalContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dni])
  @@index([internalCode])
  @@index([qrCode])
  @@index([status])
  @@index([isDeleted])
  @@map("merchants")
}

model PaymentConcept {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  periodicity Periodicity   @default(MENSUAL)
  isActive    Boolean       @default(true)
  rates       Rate[]
  obligations PaymentObligation[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_concepts")
}

model Rate {
  id             String        @id @default(uuid())
  conceptId      String
  concept        PaymentConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  merchantTypeId String?
  merchantType   MerchantType?  @relation(fields: [merchantTypeId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("PEN")
  startDate      DateTime      @default(now())
  endDate        DateTime?
  isActive       Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conceptId, merchantTypeId, isActive])
  @@map("rates")
}

model PaymentObligation {
  id          String           @id @default(uuid())
  merchantId  String
  merchant    Merchant         @relation(fields: [merchantId], references: [id])
  conceptId   String
  concept     PaymentConcept   @relation(fields: [conceptId], references: [id])
  period      String
  year        Int
  month       Int?
  day         Int?
  dueDate     DateTime
  amount      Decimal          @db.Decimal(10, 2)
  status      ObligationStatus @default(PENDIENTE)
  paidAt      DateTime?
  payment     Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, conceptId, period])
  @@index([merchantId, status])
  @@index([period, status])
  @@map("payment_obligations")
}

model Payment {
  id              String        @id @default(uuid())
  operationNumber String        @unique
  merchantId      String?
  merchant        Merchant?     @relation(fields: [merchantId], references: [id])
  conceptId       String
  concept         PaymentConcept @relation(fields: [conceptId], references: [id])
  obligationId    String?       @unique
  obligation      PaymentObligation? @relation(fields: [obligationId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  period          String
  paymentMethod   PaymentMethod @default(EFECTIVO)
  cashRegisterId  String?
  cashRegister    CashRegister? @relation(fields: [cashRegisterId], references: [id])
  collectedById   String
  collectedBy     User          @relation("CollectedByUser", fields: [collectedById], references: [id])
  idempotencyKey  String?       @unique
  deviceId        String?
  notes           String?
  paidAt          DateTime      @default(now())
  isVoided        Boolean       @default(false)
  voidedReason    String?
  voidedAt        DateTime?
  voidedById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operationNumber])
  @@index([paidAt])
  @@index([merchantId])
  @@index([conceptId])
  @@index([cashRegisterId])
  @@map("payments")
}

model CashRegister {
  id                   String             @id @default(uuid())
  name                 String
  openedById           String
  openedBy             User               @relation("OpenedByUser", fields: [openedById], references: [id])
  openingAmount        Decimal            @db.Decimal(10, 2)
  openedAt             DateTime           @default(now())
  closedById           String?
  closedBy             User?              @relation("ClosedByUser", fields: [closedById], references: [id])
  closedAt             DateTime?
  expectedCash         Decimal?           @db.Decimal(10, 2)
  countedCash          Decimal?           @db.Decimal(10, 2)
  difference           Decimal?           @db.Decimal(10, 2)
  closingObservations  String?
  status               CashRegisterStatus @default(ABIERTO)
  reopenReason         String?
  reopenedById         String?
  reopenedBy           User?              @relation("ReopenedByUser", fields: [reopenedById], references: [id])
  reopenedAt           DateTime?

  payments             Payment[]
  movements            CashMovement[]
  sanitarySessions     SanitaryServiceSession[]
  dailyClosings        DailyClosing[]
  expenses             MarketExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([openedAt])
  @@map("cash_registers")
}

model CashMovement {
  id             String           @id @default(uuid())
  cashRegisterId String
  cashRegister   CashRegister     @relation(fields: [cashRegisterId], references: [id])
  type           CashMovementType
  concept        String
  amount         Decimal          @db.Decimal(10, 2)
  reference      String?
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([cashRegisterId])
  @@map("cash_movements")
}

model SanitaryServiceSession {
  id                   String        @id @default(uuid())
  operatorId           String
  operator             User          @relation(fields: [operatorId], references: [id])
  cashRegisterId       String?
  cashRegister         CashRegister? @relation(fields: [cashRegisterId], references: [id])
  startTime            DateTime      @default(now())
  endTime              DateTime?
  urinalCount          Int           @default(0)
  urinalPrice          Decimal       @default(0.50) @db.Decimal(10, 2)
  urinalTotal          Decimal       @default(0.00) @db.Decimal(10, 2)
  toiletCount          Int           @default(0)
  toiletPrice          Decimal       @default(1.00) @db.Decimal(10, 2)
  toiletTotal          Decimal       @default(0.00) @db.Decimal(10, 2)
  totalCollected       Decimal       @default(0.00) @db.Decimal(10, 2)
  initialTicketNumber  Int?
  finalTicketNumber    Int?
  declaredTicketCount  Int?
  calculatedTicketCount Int?
  ticketDiscrepancy    Int           @default(0)
  discrepancyReason    String?
  status               SessionStatus @default(ABIERTO)
  idempotencyKey       String?       @unique
  notes                String?

  tickets              Ticket[]
  entryTickets         SanitaryEntryTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
  @@index([status])
  @@index([startTime])
  @@map("sanitary_service_sessions")
}

model Ticket {
  id          String                 @id @default(uuid())
  sessionId   String
  session     SanitaryServiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startNumber Int
  endNumber   Int
  totalIssued Int
  unitPrice   Decimal                @db.Decimal(10, 2)
  totalAmount Decimal                @db.Decimal(10, 2)
  status      TicketStatus           @default(EMITIDO)

  createdAt DateTime @default(now())

  @@map("tickets")
}

model DailyClosing {
  id                 String        @id @default(uuid())
  closingDate        DateTime      @db.Date
  cashRegisterId     String?
  cashRegister       CashRegister? @relation(fields: [cashRegisterId], references: [id])
  totalCollected     Decimal       @db.Decimal(10, 2)
  alcabalaTotal      Decimal       @db.Decimal(10, 2)
  waterTotal         Decimal       @db.Decimal(10, 2)
  sanitaryTotal      Decimal       @db.Decimal(10, 2)
  otherTotal         Decimal       @db.Decimal(10, 2)
  operationsCount    Int
  sanitaryUsersCount Int
  expectedCash       Decimal       @db.Decimal(10, 2)
  countedCash        Decimal       @db.Decimal(10, 2)
  difference         Decimal       @db.Decimal(10, 2)
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([closingDate])
  @@map("daily_closings")
}

model MonthlyClosing {
  id                 String   @id @default(uuid())
  year               Int
  month              Int
  totalExpected      Decimal  @db.Decimal(10, 2)
  totalCollected     Decimal  @db.Decimal(10, 2)
  totalPending       Decimal  @db.Decimal(10, 2)
  collectionRate     Decimal  @db.Decimal(5, 2)
  alcabalaTotal      Decimal  @db.Decimal(10, 2)
  waterTotal         Decimal  @db.Decimal(10, 2)
  sanitaryTotal      Decimal  @db.Decimal(10, 2)
  merchantsCount     Int
  paidCount          Int
  defaultersCount    Int
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
  @@map("monthly_closings")
}

model Meeting {
  id          String        @id @default(uuid())
  title       String
  date        DateTime      @db.Date
  time        String
  location    String
  description String?
  status      MeetingStatus @default(PROGRAMADA)
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])

  attendances AttendanceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@map("meetings")
}

model AttendanceEvent {
  id             String   @id @default(uuid())
  meetingId      String
  meeting        Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  dni            String
  scannedAt      DateTime @default(now())
  deviceId       String?
  registeredById String
  registeredBy   User     @relation(fields: [registeredById], references: [id])
  idempotencyKey String   @unique

  createdAt DateTime @default(now())

  @@unique([meetingId, merchantId])
  @@index([meetingId])
  @@index([merchantId])
  @@map("attendance_events")
}

model Device {
  id           String       @id @default(uuid())
  deviceId     String       @unique
  name         String
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  os           String       @default("Android")
  appVersion   String       @default("1.0.0")
  lastSyncAt   DateTime?
  status       DeviceStatus @default(ACTIVO)

  syncBatches  SyncBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("devices")
}

model SyncBatch {
  id             String          @id @default(uuid())
  deviceId       String
  device         Device          @relation(fields: [deviceId], references: [id])
  operationsCount Int
  status         String          @default("COMPLETED")
  errorSummary   String?
  startedAt      DateTime        @default(now())
  completedAt    DateTime?

  operations     SyncOperation[]

  @@map("sync_batches")
}

model SyncOperation {
  id             String    @id @default(uuid())
  batchId        String
  batch          SyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  entity         String
  action         String
  idempotencyKey String
  status         String    @default("SYNCED")
  errorDetails   String?

  createdAt DateTime @default(now())

  @@index([idempotencyKey])
  @@map("sync_operations")
}

model AuditLog {
  id             String      @id @default(uuid())
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  action         AuditAction
  module         String
  entityName     String
  entityId       String?
  previousValues Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime    @default(now())

  @@index([module])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model BusinessCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("business_categories")
}

model SanitaryEntryTicket {
  id            String                 @id @default(uuid())
  sessionId     String
  session       SanitaryServiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ticketNumber  Int
  ticketCode    String                 @unique
  amount        Decimal                @default(0.50) @db.Decimal(10, 2)
  issuedAt      DateTime               @default(now())
  isValidated   Boolean                @default(false)
  validatedAt   DateTime?
  validatedById String?

  @@index([sessionId])
  @@index([ticketCode])
  @@map("sanitary_entry_tickets")
}

model StaffMember {
  id        String         @id @default(uuid())
  firstName String
  lastName  String
  dni       String         @unique
  phone     String?
  role      String
  salary    Decimal        @db.Decimal(10, 2)
  isActive  Boolean        @default(true)
  startDate DateTime       @default(now())
  notes     String?

  payments  StaffPayment[]

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([dni])
  @@index([role])
  @@map("staff_members")
}

model StaffPayment {
  id             String        @id @default(uuid())
  staffMemberId  String
  staffMember    StaffMember   @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  period         String
  amount         Decimal       @db.Decimal(10, 2)
  paymentDate    DateTime      @default(now())
  paymentMethod  PaymentMethod @default(EFECTIVO)
  receiptNumber  String?
  status         String        @default("PAGADO")
  notes          String?
  cashMovementId String?
  createdById    String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([staffMemberId, period])
  @@index([period])
  @@map("staff_payments")
}

model Camera {
  id          String   @id @default(uuid())
  name        String
  location    String
  deviceId    String?
  streamUrl   String?
  streamType  String   @default("LOCAL_USB")
  resolution  String   @default("HD_720P")
  isActive    Boolean  @default(true)
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([location])
  @@index([isActive])
  @@map("cameras")
}

model MarketDocument {
  id             String            @id @default(uuid())
  code           String            @unique
  title          String
  concept        String            // CONTRATO, ACTA, OFICIO, RESOLUCION, RECIBO_SERVICIO, INFORME, OTROS
  conceptId      String?
  docConcept     DocumentConcept?  @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  documentDate   DateTime          @default(now()) // Fecha oficial del documento (permite 2018, etc.)
  year           Int               @default(2026)
  month          Int               @default(1)
  direction      String            @default("INTERNO") // RECIBIDO, ENVIADO, INTERNO
  senderReceiver String?           // Remitente o destinatario
  externalNumber String?           // N° oficio, N° carta, etc.
  fileUrl        String
  fileName       String
  fileType       String
  fileSize       Int?
  description    String?
  merchantId     String?
  merchant       Merchant?         @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  uploadedById   String?
  uploadedBy     User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([concept])
  @@index([code])
  @@index([year])
  @@index([month])
  @@index([documentDate])
  @@map("market_documents")
}

model Faena {
  id            String            @id @default(uuid())
  title         String
  date          DateTime          @db.Date
  time          String
  sectorToClean String?
  description   String?
  fineAmount    Decimal           @default(30.00) @db.Decimal(10, 2)
  status        MeetingStatus     @default(PROGRAMADA)
  createdById   String
  createdBy     User              @relation(fields: [createdById], references: [id])
  attendances   FaenaAttendance[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([date])
  @@index([status])
  @@map("faenas")
}

model FaenaAttendance {
  id             String   @id @default(uuid())
  faenaId        String
  faena          Faena    @relation(fields: [faenaId], references: [id], onDelete: Cascade)
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  dni            String
  scannedAt      DateTime @default(now())
  deviceId       String?
  registeredById String
  registeredBy   User     @relation(fields: [registeredById], references: [id])

  createdAt      DateTime @default(now())

  @@unique([faenaId, merchantId])
  @@index([dni])
  @@map("faena_attendances")
}

model Advertisement {
  id             String    @id @default(uuid())
  code           String    @unique
  title          String
  advertiserName String
  type           String    @default("PERIFONEO_AUDIO") // PERIFONEO_AUDIO, ESCRITA, BANNER
  audioUrl       String?
  textScript     String?
  amount         Decimal   @default(0.00) @db.Decimal(10, 2)
  startDate      DateTime  @default(now())
  endDate        DateTime?
  playbackTimes  Json?     // e.g. ["09:00", "11:30", "16:00"]
  status         String    @default("ACTIVO") // ACTIVO, PAUSADO, FINALIZADO
  createdById    String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([type])
  @@index([status])
  @@map("advertisements")
}

model Loan {
  id             String           @id @default(uuid())
  orderNumber    String           @unique // FR-PREST-0001
  date           DateTime         @default(now())
  merchantId     String?
  merchant       Merchant?        @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  borrowerName   String
  borrowerDni    String
  amount         Decimal          @db.Decimal(10, 2)
  termMonths     Int              @default(1)
  interestRate   Decimal          @default(0.00) @db.Decimal(5, 2)
  totalAmount    Decimal          @db.Decimal(10, 2)
  status         String           @default("VIGENTE") // VIGENTE, CANCELADO, MOROSO
  notes          String?
  createdById    String?
  collections    LoanCollection[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([orderNumber])
  @@index([borrowerDni])
  @@index([status])
  @@map("loans")
}

model LoanCollection {
  id              String        @id @default(uuid())
  orderNumber     String        @unique // FR-COB-0001
  loanId          String
  loan            Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  date            DateTime      @default(now())
  borrowerName    String
  description     String
  principalAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  interestAmount  Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod @default(EFECTIVO)
  receiptNumber   String?
  createdById     String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderNumber])
  @@index([loanId])
  @@map("loan_collections")
}

model DocumentCategory {
  id          String           @id @default(uuid())
  name        String           @unique
  code        String           @unique
  direction   String           @default("INTERNO") // RECIBIDO, ENVIADO, INTERNO
  description String?
  isActive    Boolean          @default(true)
  documents   MarketDocument[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("document_categories")
}

model DocumentConcept {
  id          String           @id @default(uuid())
  name        String           @unique
  code        String           @unique
  description String?
  isActive    Boolean          @default(true)
  documents   MarketDocument[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("document_concepts")
}

model AdvertisingScript {
  id                       String   @id @default(uuid())
  title                    String
  category                 String   // ASAMBLEA, FAENA, AVISO_COBRANZA, COMUNICADO_GENERAL, PROMOCION_SOCIO, OTROS
  content                  String   @db.Text
  estimatedDurationSeconds  Int      @default(30)
  isActive                 Boolean  @default(true)

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([category])
  @@map("advertising_scripts")
}

model StallRentalContract {
  id               String                   @id @default(uuid())
  contractNumber   String                   @unique // ALQ-2026-0001
  stallId          String
  stall            MarketStall              @relation(fields: [stallId], references: [id])
  stallCode        String
  sectorCode       String?
  tenantName       String
  tenantDni        String
  tenantPhone      String?
  businessCategory String?
  merchantId       String?
  merchant         Merchant?                @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  startDate        DateTime                 @db.Date
  endDate          DateTime                 @db.Date
  monthsCount      Int                      @default(6)
  monthlyRent      Decimal                  @db.Decimal(10, 2)
  interestRate     Decimal                  @default(0.00) @db.Decimal(5, 2)
  totalAmount      Decimal                  @db.Decimal(10, 2)
  depositAmount    Decimal                  @default(0.00) @db.Decimal(10, 2)
  status           String                   @default("ACTIVO") // ACTIVO, FINALIZADO, RESCINDIDO
  contractTerms    String?                  @db.Text
  notes            String?
  createdById      String?
  installments     StallRentalInstallment[]

  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([contractNumber])
  @@index([tenantDni])
  @@index([stallId])
  @@index([status])
  @@map("stall_rental_contracts")
}

model StallRentalInstallment {
  id                String              @id @default(uuid())
  contractId        String
  contract          StallRentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate           DateTime            @db.Date
  rentAmount        Decimal             @db.Decimal(10, 2)
  interestAmount    Decimal             @default(0.00) @db.Decimal(10, 2)
  totalAmount       Decimal             @db.Decimal(10, 2)
  status            String              @default("PENDIENTE") // PENDIENTE, PAGADO, VENCIDO
  paidAt            DateTime?
  paymentMethod     PaymentMethod?
  receiptNumber     String?
  notes             String?
  cashRegisterId    String?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([contractId, installmentNumber])
  @@index([dueDate])
  @@index([status])
  @@map("stall_rental_installments")
}

model MarketExpense {
  id             String        @id @default(uuid())
  code           String        @unique // EGR-2026-0001
  category       String        // PLANILLA_PERSONAL, SERVICIOS_BASICOS, MANTENIMIENTO_OBRAS, ADMINISTRATIVOS_LEGALES, PUBLICIDAD_PERIFONEO, IMPREVISTOS_OTROS
  concept        String
  amount         Decimal       @db.Decimal(10, 2)
  date           DateTime      @default(now())
  beneficiary    String        // Proveedor o persona
  documentType   String        @default("FACTURA") // FACTURA, BOLETA, RECIBO_POR_HONORARIOS, VOUCHER, DECLARACION_JURADA, OTRO
  documentNumber String?       // F001-0004523, etc.
  fileUrl        String?       // Foto o PDF del comprobante
  paymentMethod  PaymentMethod @default(EFECTIVO)
  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)
  status         String        @default("PAGADO") // PAGADO, PENDIENTE, ANULADO
  notes          String?
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([category])
  @@index([date])
  @@index([status])
  @@map("market_expenses")
}

